recv":{},"rush":{}},"splits":{},"reports":[{"week":1,"injury":"Groin","gameStatus":"Questionable","practice":"Limited Participation in Practice"},{"week":2,"injury":"Groin","practice":"Full Participation in Practice"}],"weeklyStatus":[{"week":1,"status":"INA","detail":"A01"},{"week":2,"status":"ACT","detail":"A01"},{"week":3,"status":"ACT","detail":"A01"},{"week":4,"status":"ACT","detail":"A01"},{"week":5,"status":"ACT","detail":"A01"},{"week":7,"status":"ACT","detail":"A01"},{"week":8,"status":"ACT","detail":"A01"},{"week":9,"status":"ACT","detail":"A01"},{"week":10,"status":"ACT","detail":"A01"},{"week":11,"status":"ACT","detail":"A01"}],"espn":{"summaryLabel":"2026 regular season stats","summary":[{"name":"soloTackles","label":"SOLO","value":"19","rank":"Tied-218th"},{"name":"fumblesForced","label":"Forced Fumbles","value":"0","rank":"Tied-217th"},{"name":"interceptions","label":"Interceptions","value":"0","rank":"Tied-161st"},{"name":"passesDefended","label":"Passes Defended","value":"1","rank":"Tied-321st"}],"birthPlace":"Far Rockaway, NY"},"news":[{"headline":"Lions 2026 free agency tracker: Offseason moves, signings","description":"Keep track of all the Lions' moves this offseason, including free agent signings, contracts and more.","published":"2026-03-25T18:04:10.000+00:00","url":"https://www.espn.com/nfl/story/_/id/48092610/lions-2026-free-agency-tracker-offseason-moves-signings-contract-trades","type":"Story","byline":"Eric Woodyard","source":"ESPN"},{"headline":"Buccaneers place DB Christian Izien on IR with pectoral injury","description":"The Buccaneers have placed defensive back Christian Izien on injured reserve with a pectoral injury, the team announced Thursday.","published":"2024-12-26T18:08:29.000+00:00","url":"https://www.espn.com/nfl/story/_/id/43169763/buccaneers-place-db-christian-izien-ir-pectoral-injury","type":"HeadlineNews","byline":"Jenna Laine","source":"ESPN"},{"headline":"Banged-up Buccaneers enter Lions' den without at least three starters","description":"Tampa Bay will be without at least three starters Sunday at the Detroit Lions: Calijah Kancey, Antoine Winfield Jr. and Luke Goedeke, with others possibly joining the list.","published":"2024-09-13T17:43:04.000+00:00","url":"https://www.espn.com/nfl/story/_/id/41246443/banged-buccaneers-enter-lions-den-least-three-starters","type":"HeadlineNews","byline":"Jenna Laine","source":"ESPN"},{"headline":"Buccaneers lose three cornerbacks to injury vs. Commanders","description":"The Buccaneers lost three of their four active cornerbacks Sunday against the Commanders, leaving them to lean on starter Jamel Dean and backup safety/nickelback Christian Izien, who hadn't even taken a practice snap at the position.","published":"2024-09-09T03:45:28.000+00:00","url":"https://www.espn.com/nfl/story/_/id/41187336/buccaneers-lose-three-cornerbacks-injury-vs-commanders","type":"HeadlineNews","byline":"Jenna Laine","source":"ESPN"}],"wiki":{"title":"Christian Izien","url":"https://en.wikipedia.org/wiki/Christian_Izien","description":"American football player (born 2000)","touched":"2026-11-22T23:50:18Z","intro":"Christian Izien (born June 8, 2000) is an American professional football safety for the Detroit Lions of the National Football League (NFL). He played college football for the Rutgers Scarlet Knights and was signed by the Tampa Bay Buccaneers as an undrafted free agent after the 2023 NFL draft.","sections":[{"key":"early","title":"Early life","text":"Izien was born on June 8, 2000. He grew up in Far Rockaway, New York, and attended Erasmus Hall High School. A two-way player as a cornerback and wide receiver, he earned New York City Defensive Player of the Year honors as a senior. Ranked a three-star recruit, he opted to be near home by committing to play college football for the Rutgers Scarlet Knights. He is of Nigerian descent."},{"key":"college","title":"College career","text":"As a true freshman at Rutgers in 2018, Izien appeared in four games as a special teams player. He played all 12 games as a sophomore, totaling a secondary-leading 78 tackles while starting seven times. He started all nine games in the COVID-19-shortened 2020 season, leading the team with four interceptions while also having 66 tackles. Izien started all 13 games in 2021, being named honorable mention all-conference while having 75 tackles. He again started every game in 2022, finishing with 41 consecutive starts while having 80 tackles on the year, earning another honorable mention all-conference selection. Izien declared for the 2023 NFL draft and was invited to the Hula Bowl and East–West Shrine Bowl."},{"key":"career","title":"Professional career","text":"TAMPA BAY BUCCANEERS\nAfter going unselected in the 2023 NFL draft, Izien was signed by the Tampa Bay Buccaneers as an undrafted free agent. He impressed in the off-season and made the final roster, being named the starting nickelback as a rookie. He had interceptions in his first two games, becoming only the fourth undrafted player in NFL history to accomplish the feat. As a rookie, he appeared in all 17 regular season games and made four starts. He finished with 65 total tackles (47 solo), two interceptions, two passes defended, and one forced fumble.\nIzien made 14 appearances (10 starts) for Tampa Bay in 2024, totaling one interception, three pass deflections, one forced fumble, and 75 combined tackles. On December 26, 2024, Izien was placed on injured reserve with a pectoral injury, ending his season.\n\nDETROIT LIONS\nOn March 13, 2026, Izien signed with the Detroit Lions on a one-year contract."}],"wikidataId":"Q121955776","social":{}},"transactions":[{"date":"2026-08-02","text":"Reinstated DB Christian Izien from the active/non-football injury list."},{"date":"2026-07-28","text":"Released DL Jay Tufele. Placed DB Christian Izien on the active/non-football illness list. Placed OL Christian Mahogany on the active/non-football injury list."}],"links":{"espn":"https://www.espn.com/nfl/player/_/id/4372459","pfr":"https://www.pro-football-reference.com/players/I/IzieCh00.htm","pff":"https://www.pff.com/nfl/players/christian-izien/83360","otc":"https://overthecap.com/player/christian-izien/11418","wikipedia":"https://en.wikipedia.org/wiki/Christian_Izien"},"insights":["On the field for 25% of Detroit’s defensive snaps this season.","2026 cap number of $2.0M is the 21st-largest on the roster.","Contract expires after this season.","Entered the league in 2023 as an undrafted free agent."]}