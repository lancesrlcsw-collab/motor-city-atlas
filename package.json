{
  "name": "motor-city-atlas",
  "private": true,
  "version": "1.0.0",
  "description": "An unofficial interactive 3D model of the 2026 Detroit Lions roster, built on open football data.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "data": "node --use-env-proxy --max-old-space-size=4096 pipeline/run.mjs",
    "data:check": "node pipeline/check.mjs",
    "build:artifact": "VITE_TARGET=artifact vite build && node scripts/artifact-page.mjs"
  },
  "engines": {
    "node": ">=22.21"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/saira-condensed": "^5.3.0",
    "@fontsource/saira-extra-condensed": "^5.3.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "postprocessing": "^6.39.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "csv-parse": "^7.0.3",
    "hyparquet": "^1.33.0",
    "hyparquet-compressors": "^1.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
